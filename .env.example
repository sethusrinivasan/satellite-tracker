# ── SatTrack Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The app reads these automatically if you run:  export $(cat .env | xargs)
# Or use python-dotenv in run.py (see below).

# Flask secret key — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# ── Datastore (optional headless bootstrap) ──────────────────────────────────
# If DATABASE_URL or DB_ENGINE is set on first launch, the setup wizard is skipped
# and instance/datastore.json is written automatically. You can still change the
# engine later from Admin → Database.
# DB_ENGINE=sqlite
# DATABASE_URL=sqlite:////app/instance/satellites.db
# DATABASE_URL=postgresql+psycopg://sattrack:sattrack@postgres:5432/sattrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sattrack
POSTGRES_PASSWORD=sattrack
POSTGRES_DB=sattrack

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI:  http://localhost:5000/auth/callback
#    (for production: https://yourdomain.com/auth/callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Admin access control ──────────────────────────────────────────────────────
# Comma-separated list of Google email addresses allowed into the Admin panel.
# In production, leave empty to deny access unless ADMIN_ALLOW_ANY=true.
# Local/dev can use /auth/dev-bypass only when FLASK_ENV is not production.
ADMIN_ALLOWED_EMAILS=
# Signed admin session length after Google login (days). Activity refreshes it.
# ADMIN_SESSION_DAYS=14
# ADMIN_ALLOW_ANY=false

# ── Map tiles (optional) ────────────────────────────────────────────────────
# Live orbit maps default to Esri World Dark Gray (no API key).
# To keep CARTO dark tiles, request a free key at https://carto.com/basemaps/apikey/
# CARTO_API_KEY=

# ── PostHog web analytics (optional) ────────────────────────────────────────
# Project API key from https://us.posthog.com (or https://eu.posthog.com).
# Leave empty to disable the snippet. Web Analytics is anonymous by default.
# POSTHOG_PROJECT_API_KEY=phc_your_project_api_key
# POSTHOG_HOST=https://us.i.posthog.com
# EU cloud: POSTHOG_HOST=https://eu.i.posthog.com
# Session replay is off unless you opt in (extra volume / more personal data).
# POSTHOG_SESSION_REPLAY=false
