{
  "name": "satellite-tracker",
  "version": "0.1.1",
  "description": "Real-time 2D/3D satellite tracking, orbital propagation, and offline AI discovery",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "version:current": "python3 scripts/bump_version.py --current",
    "version:check": "python3 scripts/bump_version.py --check",
    "version:bump": "python3 scripts/bump_version.py --type patch",
    "build:sidecar": "python3 scripts/build_sidecar.py",
    "sbom:generate": "python3 scripts/generate_sbom.py",
    "desktop:dev": "cd desktop && npx tauri dev",
    "desktop:build": "python3 scripts/build_sidecar.py && (cd desktop && npx tauri build)",
    "android:assets": "python3 scripts/generate_store_assets.py",
    "android:dev": "cd mobile/android && ./gradlew installDebug",
    "android:build:aab": "cd mobile/android && ./gradlew bundleRelease",
    "android:build:apk": "cd mobile/android && ./gradlew assembleRelease",
    "android:test": "cd mobile/android && ./gradlew test",
    "android:build:all": "npm run android:assets && npm run android:build:aab && npm run android:build:apk"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
