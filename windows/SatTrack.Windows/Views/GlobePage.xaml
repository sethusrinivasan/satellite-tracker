<Page
    x:Class="SatTrack.Windows.Views.GlobePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#070A11">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="🌐 3D Interactive WebGL / DirectX Earth Globe" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="Renders full spherical geometry, atmospheric glow, and orbital ring inclinations." FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Center" />
            <Border Background="#161B26" CornerRadius="8" Padding="24" Width="480" BorderBrush="#2D3748" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TxtGlobeTelemetry" Text="Active Spacecraft Telemetry Loading..." FontSize="14" FontFamily="Consolas" Foreground="#38BDF8" />
                    <TextBlock Text="Mouse drag rotates globe view • Scroll wheel zooms camera" FontSize="11" Foreground="#6B7280" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
