<Page
    x:Class="SatTrack.Windows.Views.AiDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*" Margin="16" RowSpacing="16" MaxWidth="800" HorizontalAlignment="Left">
        <!-- Header Info Card -->
        <Border Grid.Row="0" Background="#161B26" CornerRadius="8" Padding="16" BorderBrush="#2D3748" BorderThickness="1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" FontSize="20" />
                    <TextBlock Text="AI Orbital Discovery Assistant" FontSize="16" FontWeight="Bold" Foreground="White" />
                </StackPanel>
                <TextBlock Text="Ask questions about constellations, inclinations, altitudes, or active space missions. Works completely offline using local semantic heuristics." FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Prompt Input -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox x:Name="TxtPrompt" PlaceholderText="e.g. 'Show inhabited space stations' or 'GPS satellites'" KeyDown="TxtPrompt_KeyDown" />
            <Button Grid.Column="1" x:Name="BtnSend" Content="Ask Assistant" Style="{StaticResource AccentButtonStyle}" Click="BtnSend_Click" />
        </Grid>

        <!-- Response Display Card -->
        <Border Grid.Row="2" Background="#111827" CornerRadius="8" Padding="18" BorderBrush="#1F2937" BorderThickness="1">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="RESPONSE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock x:Name="TxtAiResponse" Text="Ask anything about active satellites, constellations, orbital inclinations, or pass schedules." FontSize="14" Foreground="White" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
