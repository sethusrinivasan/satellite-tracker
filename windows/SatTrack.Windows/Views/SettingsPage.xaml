<Page
    x:Class="SatTrack.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="16" MaxWidth="600" HorizontalAlignment="Left">
        <StackPanel Spacing="20">
            <TextBlock Text="Settings &amp; Configuration" FontSize="20" FontWeight="Bold" Foreground="White" />

            <Border Background="#161B26" CornerRadius="8" Padding="16" BorderBrush="#2D3748" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="ORBITAL DATA SYNC" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                    <ToggleSwitch Header="Automated Background CelesTrak Sync" IsOn="True" />
                    <TextBlock Text="CelesTrak rate-policy enforcement: minimum 2 hours between automated syncs." FontSize="11" Foreground="#6B7280" />
                    <TextBlock Text="Data Freshness: 🟢 Fresh (active preseeded catalog)" FontSize="12" Foreground="#10B981" />
                </StackPanel>
            </Border>

            <Border Background="#161B26" CornerRadius="8" Padding="16" BorderBrush="#2D3748" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="ABOUT SATTRACK" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="SatTrack Windows Store Native Edition" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Version 0.1.1 (WinUI 3 / Windows App SDK 1.6)" FontSize="12" Foreground="#9CA3AF" />
                    <TextBlock Text="Real-time 2D/3D satellite tracking, SGP4 propagation, look-angle pass predictions, and offline AI discovery." FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
