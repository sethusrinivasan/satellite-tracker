<Page
    x:Class="SatTrack.Windows.Views.TrackerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,360" Margin="12">
        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <ComboBox
                x:Name="SatSelector"
                Header="Active Spacecraft"
                Width="260"
                SelectionChanged="SatSelector_SelectionChanged" />
            <Button Content="🎯 Center Map" VerticalAlignment="Bottom" />
            <Button Content="🛤️ Toggle Orbit Track" VerticalAlignment="Bottom" />
        </StackPanel>

        <!-- Main Map Area Placeholder / Canvas -->
        <Border Grid.Row="1" Grid.Column="0" Background="#111827" CornerRadius="8" BorderBrush="#1F2937" BorderThickness="1" Margin="0,0,12,0">
            <Grid>
                <!-- World Map Projection -->
                <TextBlock Text="🌍 2D Mercator Real-Time Orbital Tracking Map" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="16" />
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Background="#CC0F172A" Padding="12" CornerRadius="6">
                    <TextBlock Text="SUB-SATELLITE GROUND POINT" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock x:Name="TxtCoordinates" Text="Lat: 0.00° | Lng: 0.00°" FontSize="14" FontFamily="Consolas" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Telemetry Card Sidebar -->
        <Border Grid.Row="1" Grid.Column="1" Background="#111827" CornerRadius="8" BorderBrush="#1F2937" BorderThickness="1" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock Text="LIVE TELEMETRY &amp; PARAMETERS" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />

                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtSatName" Text="ISS (ZARYA)" FontSize="18" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="TxtNoradMeta" Text="NORAD 25544 • LEO Orbit" FontSize="12" Foreground="#9CA3AF" />
                </StackPanel>

                <MenuFlyoutSeparator />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="LATITUDE" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtLat" Text="0.00°" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="LONGITUDE" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtLng" Text="0.00°" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="ALTITUDE" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtAlt" Text="420.0 km" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="VELOCITY" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtVel" Text="7.66 km/s" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="ORBITAL PERIOD" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtPeriod" Text="92.9 min" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                        <TextBlock x:Name="TxtFootprint" Text="2250 km" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" Foreground="White" />
                    </StackPanel>
                </Grid>

                <MenuFlyoutSeparator />

                <TextBlock Text="RAW TLE ELEMENT LINES" FontSize="10" FontWeight="Bold" Foreground="#6B7280" />
                <TextBox x:Name="TxtRawTle" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Height="80" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
