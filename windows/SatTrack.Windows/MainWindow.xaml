<Window
    x:Class="SatTrack.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SatTrack — Live Satellite Tracker"
    mc:Ignorable="d">

    <Grid Background="#0B0F19">
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged"
            Header="Live Multi-Satellite Tracker">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="2D Tracker" Tag="Tracker" Icon="Map" />
                <NavigationViewItem Content="3D Globe" Tag="Globe" Icon="Globe" />
                <NavigationViewItem Content="Pass Predictor" Tag="Passes" Icon="Calendar" />
                <NavigationViewItem Content="Satellite Catalog" Tag="Catalog" Icon="AllApps" />
                <NavigationViewItem Content="AI Discovery" Tag="Ai" Icon="Highlight" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="16" />
        </NavigationView>
    </Grid>
</Window>
