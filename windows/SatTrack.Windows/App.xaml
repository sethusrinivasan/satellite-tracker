<Application
    x:Class="SatTrack.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Global Colors & Accents -->
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161B26"/>
            <SolidColorBrush x:Key="SubtleBorderBrush" Color="#2D3748"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
